# ─────────────────────────────────────────────────────────────────────────────
# inovaweb-centro-mensajes — variables de entorno
# Copiar este archivo a .env y reemplazar los valores. NO commitear .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Postgres async) ───────────────────────────────────────────
# Driver: psycopg (v3). Modo por defecto: postgres auto-contenido del compose.
DATABASE_URL=postgresql+psycopg://messages:CHANGEME@postgres:5432/centro_mensajes

# ── Credenciales del postgres del compose (servicio 'postgres') ──────────────
POSTGRES_USER=messages
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=centro_mensajes

# ── Cifrado de credenciales de proveedores (Resend / Meta / Twilio) ──────────
# AES-256-GCM. Generar con:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY=

# ── Integracion con el Finanzas-Core (ledger consolidado) ────────────────────
FINANZAS_BASE_URL=https://finanzas.inovaweb.com.mx
# API key con scope ledger:write, etiqueta "core-messages".
# Se emite via SQL en el finanzas-core durante el bootstrap.
FINANZAS_API_KEY=
# Arquitectura D2: el CAF (Nivel 2) es el UNICO que contabiliza en el
# Finanzas-Core. Con false (default), el Centro NO auto-reporta asientos al
# ledger (sigue enviando y contando mensajes igual). Poner true solo para el
# comportamiento legacy de auto-reporte directo.
REPORT_TO_FINANZAS=false

# ── Servicio ─────────────────────────────────────────────────────────────────
PORT=8001
ENV=dev
LOG_LEVEL=INFO

# ── Tracking de email (URL publica base para pixel y click) ──────────────────
# En produccion: https://mensajes.inovaweb.com.mx
# En dev local: http://localhost:8005
PUBLIC_BASE_URL=https://mensajes.inovaweb.com.mx

# ── Redis (opcional, para rate limiting) ─────────────────────────────────────
# Si no se configura, el rate limit se omite con graceful degradation.
# REDIS_URL=redis://localhost:6379/0
